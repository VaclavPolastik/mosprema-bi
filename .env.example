# Vzor konfigurace. Zkopiruj na .env a doplnit nic nemusis - hodnoty nize
# jsou vyvojove a staci tak, jak jsou:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (bash)
#
# Skutecny .env je zamerne mimo git. Ne proto, ze by tady bylo tajemstvi -
# vsechny sluzby poslouchaji jen na 127.0.0.1 a data jsou verejna mereni z
# bakalarske prace - ale protoze commitovat soubor jmenem .env je navyk,
# ktery se drive nebo pozdeji vymsti.

POSTGRES_USER=mosprema
POSTGRES_PASSWORD=mosprema
POSTGRES_DB=mosprema

INFLUX_USER=mosprema
INFLUX_PASSWORD=mosprema123
INFLUX_ORG=upol
INFLUX_BUCKET=mosprema
INFLUX_TOKEN=mosprema-local-dev-token

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# 3000 obvykle drzi nativni instalace Grafany (sluzba Windows).
# Nemas-li ji, muzes si sem 3000 vratit.
GRAFANA_PORT=3001
