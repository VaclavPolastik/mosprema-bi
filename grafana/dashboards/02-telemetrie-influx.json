    {
      "id": 10,
      "type": "timeseries",
      "title": "Teploty ve třech hloubkách a ve vzduchu",
      "description": "temp_1 je nejhlouběji, temp_3 nejmělčeji. Rozestup mezi křivkami ukazuje, jak je voda teplotně rozvrstvená; jejich splynutí znamená, že čidla vyčnívala nad hladinu.",
      "datasource": { "type": "influxdb", "uid": "mosprema-influx" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"mosprema\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\" and r.quality == \"OK\")\n  |> filter(fn: (r) => r.sensor == \"temp_1\" or r.sensor == \"temp_2\" or r.sensor == \"temp_3\" or r.sensor == \"temp_air\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"sensor\"])"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
