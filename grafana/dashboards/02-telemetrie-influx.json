          "unit": "celsius",
          "custom": {
            "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never",
            "spanNulls": false, "gradientMode": "none"
          }
        },
        "overrides": []
      }
    },

